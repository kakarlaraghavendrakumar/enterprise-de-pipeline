         as
        (with orders as (
    select * from ANALYTICS_DB.MARTS.fct_orders
)

select
    customer_id,
    count(distinct order_id) as total_orders,
    sum(case when order_status != 'CANCELLED' then order_amount else 0 end) as lifetime_value,
